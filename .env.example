# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=splito
POSTGRES_PASSWORD=splito_secret
POSTGRES_DB=splito_db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://splito:splito_secret@127.0.0.1:5432/splito_db
SYNC_DATABASE_URL=postgresql://splito:splito_secret@127.0.0.1:5432/splito_db

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0

# ─── JWT ─────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Use onboarding@resend.dev for testing without a custom domain
EMAIL_FROM=onboarding@resend.dev
# Your Flutter app's base URL — used to build links in emails
FRONTEND_URL=http://localhost:3000

# ─── Token expiry ─────────────────────────────────────────────────────────────
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_MINUTES=15


# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
APP_NAME=Splito
API_VERSION=v1